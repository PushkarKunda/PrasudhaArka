# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Configuration (Admin Gallery Uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# --- Server-side ONLY env vars (set on Vercel AND Netlify, never VITE_*) ---
# Used by /api/gallery-delete to verify the admin session and destroy
# Cloudinary assets on delete. The site works without them (delete then
# only removes the Firestore record).
# FIREBASE_WEB_API_KEY=your_firebase_web_api_key
# ADMIN_EMAILS=admin@example.com
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Access Allowlist (comma-separated Firebase Auth emails and/or UIDs).
# Only these accounts can access /admin. Leave empty to allow any
# signed-in account (not recommended for production).
VITE_ADMIN_EMAILS=admin@example.com
