rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin-uploaded gallery media (images/videos via Cloudinary).
    // Public read so visitors can view the gallery; write restricted to
    // signed-in admin accounts.
    // HARDENING: tighten the write rule to specific accounts (server-side,
    // this cannot be bypassed even if the client allowlist is removed):
    //   allow write: if request.auth.token.email == 'your-admin@email.com';
    match /gallery_media/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
