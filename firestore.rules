rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin-uploaded gallery media (images/videos via Cloudinary).
    // Public read so visitors can view the gallery; write restricted to
    // signed-in admin accounts. Tighten the write rule to a specific UID:
    //   allow write: if request.auth.uid == 'YOUR_ADMIN_UID';
    match /gallery_media/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
